# ==============================================================================
# Heart Disease Early Risk Prediction - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL SECRETS LOCALLY
# NEVER COMMIT .env TO GIT REPOSITORY
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_URL=http://127.0.0.1:8000

# Security & Authentication Secrets (Generate secure random keys)
API_SECRET_KEY=generate_with_manage_secrets_script

# Database Configuration (SQLite local path)
DATABASE_URL=sqlite:///./data/heart_disease.db

# Backup Encryption (AES-256 Fernet Key for database and archive backups)
BACKUP_ENCRYPTION_KEY=generate_with_manage_secrets_script

# KeePassXC Secret Storage Configuration
KEEPASS_DB_PATH=./secrets/heart_disease_vault.kdbx

# Google Drive (rclone) Configuration
RCLONE_REMOTE_NAME=gdrive
RCLONE_BACKUP_DIR=HeartDiseasePrediction-Backups
